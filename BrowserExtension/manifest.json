{
  "manifest_version": 3,
  "name": "Ward",
  "description": "Пароли и passkey из Ward — локального менеджера паролей на этом Mac.",
  "version": "1.0",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": ["nativeMessaging", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["webauthn.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true }
  ]
}
